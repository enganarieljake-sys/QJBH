APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dormitory_database
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Supabase Storage for payment QR codes and receipts (S3-compatible API).
# Get the keys from Supabase Dashboard -> Storage -> S3 Configuration -> Access keys.
# Keep PAYMENT_FILES_DISK=local until the keys are filled in, then switch it to supabase.
PAYMENT_FILES_DISK=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_BUCKET=unistay-payments
SUPABASE_S3_REGION=ap-northeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Operational backups. BACKUP_FILES_DISK defaults to the Supabase disk above.
# For disaster isolation, configure a separate S3-compatible disk and set its
# Laravel disk name here. Daily database backups retain 35 days by default.
OPERATIONS_BACKUP_ENABLED=true
BACKUP_FILES_DISK=supabase
BACKUP_PREFIX=_operations-backups
BACKUP_RETENTION_DAYS=35
BACKUP_STORAGE_SNAPSHOT_DAY=0

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /cron/bill-reminders.
CRON_SECRET=
RESET_CODE_EMAIL=enganarieljake@gmail.com

# Free standards-based Web Push. Generate once with Minishlink\WebPush\VAPID::createVapidKeys().
VAPID_SUBJECT=mailto:enganarieljake@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# QJ Bot (admin assistant). Free models only; get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,stealth/space-bunny-alpha,qwen/qwen3.8-27b:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,openrouter/free

# QJ Bot's default AI: Groq free plan (no card). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,qwen/qwen3-32b

# QJ Bot's default AI: NVIDIA (Nemotron), free key from https://build.nvidia.com
NVIDIA_API_KEY=
